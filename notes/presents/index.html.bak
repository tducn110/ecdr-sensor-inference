                <!-- Latency Benchmark & Provenance Hashes -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-center">
                    <div class="acad-card space-y-4">
                        <h4 class="text-base font-serif font-bold text-black">Đo Kiểm Độ Trễ Chuẩn CPU (Xeon W-11855M)</h4>
                        <div class="img-frame p-2">
                            <img src="assets/cpu_latency_benchmark.png" alt="Latency Benchmark" class="w-full border border-black" loading="eager">
                        </div>
                        <div class="p-3 border border-black bg-zinc-50 text-xs font-mono space-y-1">
                            <div>Platform: <span class="font-bold text-black">Intel Xeon W-11855M CPU @ 3.20GHz (1 thread, FP32)</span></div>
                            <div>Forward-only: <span class="font-bold text-black">0.1734 ms</span> (median: 0.1650 ms, p95: 0.2153 ms)</div>
                            <div>Preprocess + Forward: <span class="font-bold text-black">0.2011 ms</span> ($T_{\mathrm{FullCNN}}$ cơ sở)</div>
                        </div>
                    </div>

                    <div class="acad-card space-y-3 font-mono text-xs">
