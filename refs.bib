@misc{xiang2026lipcache,
  title        = {LipCache: A Local Inference Proxy with Certified Caching for Edge Image Classification Service},
  author       = {Xiang, Zhengzhe and Chen, Yinlin and Ying, Fuli and Zhou, Binbin and Zhao, Hailiang and Dustdar, Schahram},
  year         = {2026},
  eprint       = {2608.13144},
  archivePrefix= {arXiv},
  primaryClass = {cs.DC},
  url          = {https://arxiv.org/abs/2608.13144},
  note         = {Verified from full PDF arXiv:2608.13144v1 (21 pages, fetched 2026-10-15). Remark 5.2: certificate is GuardNet-side only, MainNet-side guarantee explicitly excluded -- quote: theoretical certificate of LipCache is on the GuardNet side, not on the MainNet side. Sec 7.1: all experiments on i.i.d. test sets; temporal redundancy, concept drift, consecutive-frame reuse in streaming left as future work. Speedup up to 1.65x on CIFAR/Tiny-ImageNet/SVHN; radii r_i conservative and r*_i per-pair (Remark 5.1)}
}

@misc{varghese2026stbp,
  title        = {Hybrid Robustness Verification for Spatio-Temporal Neural Networks},
  author       = {Varghese, Sherwin and Wicker, Matthew and Lomuscio, Alessio},
  year         = {2026},
  eprint       = {2606.09746},
  archivePrefix= {arXiv},
  primaryClass = {cs.CV},
  url          = {https://arxiv.org/abs/2606.09746},
  note         = {Submitted 8 Jun 2026, accepted SAIV 2026 (LNCS 16831, pp.3-35, DOI chapter 10.1007/978-3-032-32357-6_1). Numbering caveat: arXiv footer says 9th International Symposium on AI Verification, Springer says Third International Symposium -- same event, different ordinal convention, does not affect publication status. Verified from full PDF v1 (33 pages, fetched 2026-10-15). Checksum local copy papers/STBP_Varghese2026_arXiv2606.09746.pdf: md5 07fa78504afb302ecb958822f1fd003b, size 3,529,184 bytes == content-length reported by arxiv.org/pdf/2606.09746v1 at fetch time (report.md-era 2.5MB claim was stale or different build). STBP = exact closed-form first conv layer + scalable propagation after; ST-Bench benchmark; up to 1.7x higher certified robust accuracy vs IBP under identical budgets (NOT speed). Limitations: STBP-LJ pipeline is empirical estimator (Remark 1, Sec 4.3.1), only STBP-IBP/Lipschitz strictly sound; large VLMs/transformers still open; perturbation magnitudes smaller than single-image linf regime}
}

