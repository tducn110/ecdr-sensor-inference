                        <h2 class="text-2xl font-serif font-bold text-black">Mã Nguồn Python Bộ Kiểm Chứng Verifier &amp; Cận IBP</h2>
                    </div>
                    <span class="acad-badge acad-badge-black font-mono">ACTUAL-GRAPH VERIFIER</span>
                </div>

                <div class="border border-black bg-white">
                    <div class="flex items-center justify-between p-3 border-b border-black bg-zinc-100">
                        <div class="flex space-x-2">
                            <button onclick="switchCodeTabW3(1)" id="btn-w3-c1" class="px-3 py-1 border border-black bg-black text-white font-mono text-xs font-bold">1. IBP Propagation Core</button>
                            <button onclick="switchCodeTabW3(2)" id="btn-w3-c2" class="px-3 py-1 border border-black bg-white text-zinc-700 hover:bg-zinc-100 font-mono text-xs">2. Direct Margin Bound</button>
                            <button onclick="switchCodeTabW3(3)" id="btn-w3-c3" class="px-3 py-1 border border-black bg-white text-zinc-700 hover:bg-zinc-100 font-mono text-xs">3. Replay &amp; Fail-Closed</button>
                        </div>
                        <button onclick="copyCodeW3()" class="px-3 py-1 border border-black bg-white hover:bg-zinc-100 font-mono text-xs text-black font-bold">Sao Chép Mã</button>
                    </div>

                    <!-- Pane 1: IBP Propagation Core -->
                    <div id="w3-code-pane-1" class="p-4 bg-zinc-900 text-zinc-100 font-mono text-xs overflow-x-auto">
                        <pre><code># ecdr/week3_verifier.py — Interval Bound Propagation qua Conv1D + MaxPool + Linear
import torch
import torch.nn.functional as F

class IntervalTensor:
    def __init__(self, lower, upper):
        self.lower = lower  # Cận dưới của tensor
        self.upper = upper  # Cận trên của tensor

def propagate_conv1d_ibp(interval_x, weight, bias):
    \"\"\"
    Truyền khoảng cận IBP qua tầng Conv1D:
    weight_pos = max(W, 0), weight_neg = min(W, 0)
    lower_out = conv(L, W_pos) + conv(U, W_neg) + bias
    upper_out = conv(U, W_pos) + conv(L, W_neg) + bias
    \"\"\"
    w_pos = torch.clamp(weight, min=0.0)
    w_neg = torch.clamp(weight, max=0.0)
    
    l_out = F.conv1d(interval_x.lower, w_pos) + F.conv1d(interval_x.upper, w_neg) + bias.view(1, -1, 1)
    u_out = F.conv1d(interval_x.upper, w_pos) + F.conv1d(interval_x.lower, w_neg) + bias.view(1, -1, 1)
    
    return IntervalTensor(l_out, u_out)</code></pre>
                    </div>

                    <!-- Pane 2: Direct Margin Bound -->
                    <div id="w3-code-pane-2" class="p-4 bg-zinc-900 text-zinc-100 font-mono text-xs overflow-x-auto hidden">
                        <pre><code># ecdr/week3_verifier.py — Định lý H08: Cận hiệu biên trực tiếp (Direct Margin Bounds)
def compute_direct_margin_lower_bound(penultimate_interval, weight_c, weight_j, bias_c, bias_j):
    \"\"\"
    Thay vì tính riêng lẻ lower(F_c) và upper(F_j) rồi trừ (gây mất mát tương quan),
    ta trừ trực tiếp vector trọng số tại tầng Linear cuối:
    W_diff = W_c - W_j
    bias_diff = bias_c - bias_j
    \"\"\"
    w_diff = weight_c - weight_j
    b_diff = bias_c - bias_j
    
    w_pos = torch.clamp(w_diff, min=0.0)
    w_neg = torch.clamp(w_diff, max=0.0)
    
    # Tính cận dưới chính xác của hiệu F_c(X) - F_j(X)
    margin_lower = torch.matmul(penultimate_interval.lower, w_pos) + \
                   torch.matmul(penultimate_interval.upper, w_neg) + b_diff
                   
    return margin_lower.item()  # Phải > 0 với mọi j != c</code></pre>
                    </div>

                    <!-- Pane 3: Replay & Fail-Closed -->
                    <div id="w3-code-pane-3" class="p-4 bg-zinc-900 text-zinc-100 font-mono text-xs overflow-x-auto hidden">
                        <pre><code># ecdr/replay.py — Giao thức Streaming Replay bảo đảm Fail-Closed
def evaluate_streaming_window(current_window, active_certificate, reference_cnn):
    \"\"\"
    Kiểm tra 7 bước điều kiện tái sử dụng:
    1. Chứng chỉ tồn tại và còn hạn?
    2. Model hash khớp chính xác SHA256?
    3. current_window nằm trong miền S?
    \"\"\"
    if active_certificate is not None:
        if active_certificate.is_member(current_window):
            # REUSE CLASS: Không forward CNN, 0 FLOPs
            return active_certificate.anchor_class, True
            
    # FAIL-CLOSED FALLBACK: Chạy toàn bộ 283,692 tham số của Frozen CNN
    logits = reference_cnn(current_window)
    predicted_class = torch.argmax(logits, dim=-1).item()
    
    # Khởi tạo mỏ neo mới cho các cửa sổ tiếp theo
    return predicted_class, False</code></pre>
                    </div>
                </div>
            </section>

            <!-- SECTION W3-7: CHUYỂN GIAO TUẦN 4 & LỘ TRÌNH MỞ RỘNG -->
            <section id="w3-handover" class="space-y-6 max-w-4xl mx-auto">
                <div class="flex items-center justify-between border-b border-black pb-4">
                    <div class="flex items-center space-x-3">
                        <span class="w-8 h-8 border border-black bg-black text-white font-mono font-bold flex items-center justify-center text-xs">7</span>
                        <h2 class="text-2xl font-serif font-bold text-black">Chuyển Giao Tuần 4: Ba Hướng Giải Quyết Kỹ Thuật Thực Chất</h2>
                    </div>
                    <span class="acad-badge acad-badge-black font-mono">ROADMAP TO SPEEDUP</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="acad-card space-y-3">
                        <span class="acad-badge acad-badge-black font-mono">HƯỚNG 1 &bull; P0</span>
                        <h4 class="font-serif font-bold text-black text-base">Adaptive Dynamic Bounds</h4>
                        <p class="text-xs text-zinc-700 font-serif leading-relaxed">
                            Thay vì cố định hình hộp trục tọa độ tĩnh $\rho = 10^{-6}$, thiết kế miền hình học co giãn theo vector động lượng vận tốc góc (Angular Velocity Momentum) để bao trọn cửa sổ kế tiếp dọc theo hướng gradient.
                        </p>
                    </div>

                    <div class="acad-card space-y-3">
                        <span class="acad-badge acad-badge-black font-mono">HƯỚNG 2 &bull; P0</span>
                        <h4 class="font-serif font-bold text-black text-base">Early Event Trigger Filter</h4>
                        <p class="text-xs text-zinc-700 font-serif leading-relaxed">
                            Xây dựng bộ kích hoạt sớm siêu nhẹ ($O(1)$) dựa trên tổng bình phương năng lượng gia tốc ($E = a_x^2 + a_y^2 + a_z^2$). Nếu phát hiện rung lắc vượt ngưỡng, lập tức kích hoạt Fallback mà không tốn 1.48 ms chạy Verifier.
                        </p>
                    </div>

                    <div class="acad-card space-y-3">
                        <span class="acad-badge acad-badge-black font-mono">HƯỚNG 3 &bull; P1</span>
                        <h4 class="font-serif font-bold text-black text-base">Incremental Feature Reuse</h4>
                        <p class="text-xs text-zinc-700 font-serif leading-relaxed">
                            Tận dụng Định lý H13 (384 tọa độ trùng khớp bitwise) để tái sử dụng bản đồ đặc trưng Conv1/Conv2 đã tính ở cửa sổ trước, chỉ thực hiện tích chập trên 384 tọa độ mới, giảm 50% FLOPs của tầng Conv.
                        </p>
                    </div>
                </div>

                <div class="p-6 border border-black bg-zinc-50 text-center space-y-3">
                    <p class="text-sm font-serif text-black font-medium">
                        Toàn bộ 93/93 test cases, mã nguồn verifier và receipts Tuần 3 được lưu trữ tại: <code class="font-mono bg-white px-2 py-0.5 border border-black">output/week3_certification_20261103/</code>
                    </p>
                    <div class="flex justify-center space-x-4">
                        <button onclick="switchMasterWeek(1)" class="px-4 py-2 border border-black bg-white hover:bg-zinc-100 font-mono text-xs font-bold text-black">
                            &larr; Xem Chi Tiết Tuần 1
                        </button>
                        <button onclick="switchMasterWeek(2)" class="px-4 py-2 border border-black bg-white hover:bg-zinc-100 font-mono text-xs font-bold text-black">
                            &larr; Xem Chi Tiết Tuần 2
                        </button>
                    </div>
                </div>
            </section>

        </div>

        <!-- FOOTER (ACADEMIC MONOCHROME PRINT) -->
        <footer class="border-t border-black pt-12 pb-16 text-center space-y-4">
            <div class="w-10 h-10 border border-black bg-black text-white flex items-center justify-center mx-auto text-sm font-serif font-bold">
                ECDR
            </div>
            <h3 class="text-xl font-serif font-bold text-black">Event-Conditioned Certified Decision Reuse (ECDR) Research Portal</h3>
            <p class="text-xs font-serif text-zinc-600 max-w-md mx-auto leading-relaxed">
                Báo cáo nghiên cứu học thuật &bull; Nguồn chuẩn tắc: <code class="font-mono text-black font-bold">00_OVERVIEW/02_Week_1_Project_Brief.tex</code> &bull; Niêm phong ngày 02/11/2026.
            </p>
            <div class="pt-2 font-mono text-xs">
                <a href="#intervention" class="underline text-black font-bold hover:text-zinc-600">&uarr; Quay lại Đầu Trang</a>
            </div>
        </footer>

    </main>

    <!-- MASTER INTERACTIVE SCRIPTS -->
    <script>
        // 1. Master Week Switcher (Week 1, Week 2, Week 3)
        function switchMasterWeek(weekNum) {
            document.querySelectorAll('[id^="content-week-"]').forEach(el => el.classList.add('hidden'));
            const targetContent = document.getElementById(`content-week-${weekNum}`);
            if (targetContent) targetContent.classList.remove('hidden');

            document.querySelectorAll('[id^="tab-master-w"]').forEach(btn => {
                btn.className = "tab-btn px-3 py-1 font-medium rounded-sm border transition-all";
            });
            const activeTab = document.getElementById(`tab-master-w${weekNum}`);
            if (activeTab) activeTab.className = "tab-btn active px-3 py-1 font-bold rounded-sm border transition-all";

            document.getElementById('subnav-week1').classList.toggle('hidden', weekNum !== 1);
            document.getElementById('subnav-week2').classList.toggle('hidden', weekNum !== 2);
            document.getElementById('subnav-week3').classList.toggle('hidden', weekNum !== 3);

            const bPrim = document.getElementById('badge-primary');
            const bSec = document.getElementById('badge-secondary');
            if (weekNum === 1) {
                bPrim.innerText = "ARTIFACT 65/65 PASS";
                bSec.innerText = "GATE G2 HOLD";
                bSec.className = "acad-badge acad-badge-gray font-mono";
            } else if (weekNum === 2) {
                bPrim.innerText = "RAW SAMPLES 1.21M";
                bSec.innerText = "SUBJECTS 17/4/9";
                bSec.className = "acad-badge acad-badge-gray font-mono";
            } else if (weekNum === 3) {
                bPrim.innerText = "TESTS 93/93 PASS";
                bSec.innerText = "REUSE 0.0% (FAIL-CLOSED)";
                bSec.className = "acad-badge acad-badge-black font-mono";
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // 2. Week 1 Slide Carousel (6 Slides)
        let currentSlideW1 = 1;
        const totalSlidesW1 = 6;

        function goToSlide(n) {
            if (n < 1 || n > totalSlidesW1) return;
            currentSlideW1 = n;
            document.querySelectorAll('#presentation .slide-item').forEach(el => el.classList.remove('active'));
            const activeSlide = document.getElementById(`slide-${n}`);
            if (activeSlide) activeSlide.classList.add('active');

            document.querySelectorAll('#slide-pills .slide-pill').forEach(btn => {
                const s = parseInt(btn.getAttribute('data-slide'));
                btn.className = (s === n) 
                    ? "slide-pill px-3 py-1 text-xs font-mono font-bold border border-black bg-black text-white"
                    : "slide-pill px-3 py-1 text-xs font-mono font-medium border border-black bg-white text-zinc-600 hover:bg-zinc-100";
            });
        }
        function nextSlide() { goToSlide(currentSlideW1 >= totalSlidesW1 ? 1 : currentSlideW1 + 1); }
        function prevSlide() { goToSlide(currentSlideW1 <= 1 ? totalSlidesW1 : currentSlideW1 - 1); }

        // 3. Week 2 Slide Deck (13 Slides)
        const week2SlidesData = [
            { id: 1, title: "Slide 01: Tổng quan Dự án & Kế thừa Tuần 1", tag: "Overview", desc: "Xác lập bối cảnh kế thừa: SmallCNN1D 283,692 tham số đã khóa (Seed 43 Epoch 8) đóng vai trò hàm tham chiếu F(X). Week 2 tập trung giải mã 1,215,488 mẫu dữ liệu cảm biến thô và kiến trúc mô hình." },
            { id: 2, title: "Slide 02: Làm rõ Bài toán Nghiên cứu (Problem Refinement)", tag: "Problem", desc: "Phân biệt rành mạch giữa bài toán phân loại hoạt động thông thường (tối ưu Accuracy) và bài toán Certified Decision Reuse (bỏ qua forward mà bảo toàn 100% quyết định)." },
            { id: 3, title: "Slide 03: Ba Câu hỏi Nghiên cứu Cốt lõi (RQ1–RQ3)", tag: "Research Questions", desc: "RQ1: Có tồn tại miền bất biến S quanh cửa sổ mỏ neo không? RQ2: Tỷ lệ tái sử dụng trên dữ liệu thực tế là bao nhiêu? RQ3: Có đạt tốc độ tăng tốc thực tế sau khi tính toàn bộ overhead verifier không?" },
            { id: 4, title: "Slide 04: HAPT Dataset: Tín hiệu Thô & Dạng sóng 6 Kênh", tag: "Data Anatomy", desc: "Dữ liệu 50 Hz thu nhận từ smartphone gắn ở hông của 30 tình nguyện viên. 3 kênh Accel (g) đo gia tốc trọng trường và bước đi; 3 kênh Gyro (rad/s) đo vận tốc góc xoay hông." },
            { id: 5, title: "Slide 05: Trích xuất Ma trận Đặc trưng & Gán nhãn Đa số", tag: "Feature Matrix", desc: "Cắt lát tensor [6 x 128] tương ứng 2.56 giây. Chính sách gán nhãn đa số >= 60% lọc ra 10,361 cửa sổ thuần túy và 1,917 cửa sổ đa số, loại bỏ 1,588 cửa sổ mơ hồ." },
            { id: 6, title: "Slide 06: Subject Split 17/4/9 & Chuẩn hóa Tránh Rò rỉ", tag: "Data Leakage", desc: "Mean và Std của 6 kênh được tính độc quyền trên 17 người dùng tập Train. Tập Val (4 người) và Test (9 người) không bao giờ tham gia tính Z-score, triệt tiêu 100% rò rỉ dữ liệu." },
            { id: 7, title: "Slide 07: Stride 64 & Tiền đề Toán học Chồng lấn 50%", tag: "Overlap Invariance", desc: "Bước trượt 64 mẫu (1.28 giây) tạo ra sự chồng lấn chính xác 64 mẫu thời gian giữa hai cửa sổ kế tiếp. 17,392 cặp cửa sổ kế tiếp có 384 tọa độ trùng khớp hoàn toàn (MAE = 0.00000)." },
            { id: 8, title: "Slide 08: Tại sao chọn CNN1D? Kiến trúc & 1.46M MACs", tag: "Model Architecture", desc: "Mô hình gồm 3 khối Conv1D (k=5, 5, 3), 2 tầng MaxPool1D và tầng Linear 2048->128 chiếm tới 92.45% tham số (262,272 tham số). Tổng chi phí 1.46 triệu MACs tốn 0.201 ms CPU." },
            { id: 9, title: "Slide 09: Frozen CNN: Hành vi Baseline & Đánh giá Hiệu năng", tag: "Baseline Performance", desc: "Đánh giá trên 3,572 cửa sổ Test: Accuracy đạt 89.05%, Macro-F1 đạt 0.7763. Nhóm 6 hoạt động cơ bản đạt F1 = 91.4%, nhóm 6 hoạt động chuyển thế chỉ đạt F1 = 63.9%." },
            { id: 10, title: "Slide 10: Chồng lấn Thời gian & Độ Ổn định Quyết định Thực nghiệm", tag: "Temporal Stability", desc: "Trên 5,034 cặp cửa sổ kế tiếp: các vùng ổn định giữ nguyên nhãn ở tỷ lệ 97.82%, nhưng các vùng chuyển tư thế lật nhãn liên tục (chỉ 52.27% giữ nguyên)." },
            { id: 11, title: "Slide 11: Cơ chế Khái niệm của Certified Decision Reuse", tag: "Certification Math", desc: "Thay vì đoán dựa trên overlap, ECDR thiết lập 11 bất đẳng thức biên logit: Fc(X) - Fj(X) > 0 với mọi j != c. Nếu cửa sổ mới nằm trong miền S thỏa mãn điều kiện này, quyết định c được tái sử dụng an toàn." },
            { id: 12, title: "Slide 12: WBS Cập nhật & Kế hoạch Triển khai Tuần 3", tag: "Work Breakdown", desc: "Chuyển giao 3 hạng mục cho Tuần 3: (1) Xây dựng bộ verifier số học IBP trên đồ thị SmallCNN1D thật, (2) Đánh giá tỷ lệ reuse thực tế, (3) Đo đạc benchmark độ trễ toàn trình." },
            { id: 13, title: "Slide 13: Weekly Project Dashboard & Quản trị Rủi ro", tag: "Project Dashboard", desc: "Xác lập trạng thái các Quality Gates: G1 PASS, G2 HOLD do mất cân bằng dữ liệu chuyển thế (29.1x). Rủi ro rò rỉ dữ liệu đã được giải quyết triệt để nhờ Train-Only Z-Score." }
        ];

        let currentSlideW2 = 1;
        function renderSlideW2(n) {
            currentSlideW2 = n;
            document.getElementById('slide-num-w2').innerText = `${n} / ${week2SlidesData.length}`;
            const s = week2SlidesData[n - 1];
            const viewport = document.getElementById('w2-slide-viewport');
            viewport.innerHTML = `
                <div class="space-y-4">
                    <div class="flex items-center justify-between border-b border-black pb-2">
                        <span class="acad-badge acad-badge-black font-mono">${s.tag}</span>
                        <span class="font-mono text-xs text-zinc-500 font-bold">SLIDE ${s.id < 10 ? '0' + s.id : s.id} OF 13</span>
                    </div>
                    <h3 class="text-xl font-serif font-bold text-black">${s.title}</h3>
                    <p class="text-sm font-serif text-zinc-800 leading-relaxed">${s.desc}</p>
                </div>
                <div class="pt-4 border-t border-zinc-200 flex justify-between items-center text-xs font-mono text-zinc-600">
                    <span>Repository Anchor: <code>output/week2_foundations_20261103/</code></span>
                    <span>Status: Verified Canonical Closeout</span>
                </div>
            `;
            document.querySelectorAll('#w2-slide-pills button').forEach((btn, idx) => {
                btn.className = (idx + 1 === n) 
                    ? "px-2.5 py-1 text-xs font-mono font-bold border border-black bg-black text-white"
                    : "px-2.5 py-1 text-xs font-mono font-medium border border-black bg-white text-zinc-600 hover:bg-zinc-100";
            });
        }
        function nextSlideW2() { renderSlideW2(currentSlideW2 >= week2SlidesData.length ? 1 : currentSlideW2 + 1); }
        function prevSlideW2() { renderSlideW2(currentSlideW2 <= 1 ? week2SlidesData.length : currentSlideW2 - 1); }

        // 4. Week 3 Slide Deck (21 Slides)
        const week3SlidesData = [
            { id: 1, title: "Slide 01: Từ Phân Loại CNN đến Bảo Toàn Quyết Định Có Chứng Nhận", tag: "Paradigm Shift", desc: "Chuyển dịch trọng tâm nghiên cứu: Không huấn luyện thêm để tăng Accuracy. Khóa SmallCNN1D làm hàm tham chiếu cố định và tìm điều kiện toán học để bypass forward." },
            { id: 2, title: "Slide 02: Hợp Đồng Bất Biến của Mô Hình Tham Chiếu (Frozen Reference)", tag: "Invariant Contract", desc: "Khóa chặt kiến trúc K=12, bộ tham số Seed 43 Epoch 8 (SHA256: 8ffc5dd8...), bảng chuẩn hóa Z-score (SHA256: aa8e1cc2...) và giao thức fail-closed." },
            { id: 3, title: "Slide 03: Câu Hỏi Nghiên Cứu (RQ1–RQ3) & 5 Sản Phẩm Kỹ Thuật", tag: "Research Questions", desc: "Xác lập 3 câu hỏi nghiên cứu và bàn giao 5 sản phẩm: 2 Báo cáo toán học (59 trang), Bộ Verifier K=12, Test suite 93 tests, Bộ dataset 5,053 cửa sổ test và Giao thức đo độ trễ." },
            { id: 4, title: "Slide 04: Bản Đồ Phân Loại 24 Giả Thuyết Khoa Học (H01–H24)", tag: "Hypothesis Map", desc: "Nguyên tắc khoa học nghiêm ngặt: Phân biệt rõ Tính đúng đắn toán học (Soundness) != Độ phủ miền (Coverage) != Tiết kiệm chi phí ròng (Net Speedup)." },
            { id: 5, title: "Slide 05: Cấu Trúc Cửa Sổ Cảm Biến 768 Chiều & Chồng Lấn 50%", tag: "Input Geometry", desc: "Mỗi cửa sổ gồm 768 tọa độ số thực. Stride 64 giữ nguyên 384 tọa độ cũ và bổ sung 384 tọa độ mới. Bài toán chứng nhận rút gọn về kiểm tra 384 chiều mới xuất hiện." },
            { id: 6, title: "Slide 06: Margin Theorem: min_{j!=c} (Fc - Fj) > 0", tag: "Margin Theorem", desc: "Định lý cốt lõi H05: Nếu cận dưới của hiệu logit giữa lớp mỏ neo c và tất cả 11 lớp cạnh tranh đều strictly positive trên miền S, thì argmax được bảo toàn 100% với 0 sai lệch." },
            { id: 7, title: "Slide 07: Kỹ Thuật IBP trên Đồ Thị Thật: Direct Pairwise Margins", tag: "IBP Technique", desc: "Định lý H08: Thay vì trừ cận riêng lẻ gây mất tương quan, thực hiện phép trừ trực tiếp trọng số tại tầng Linear cuối cùng: W_diff = W_c - W_j để thu hẹp độ lỏng của cận." },
            { id: 8, title: "Slide 08: Thiết Kế Miền Ứng Viên: Diagonal Box vs Fixed-Overlap Wave", tag: "Domain Design", desc: "Khảo sát 2 dạng miền: Hình hộp đường chéo 768 chiều (Box domain) và miền sóng thời gian 384 chiều (Wave domain). Cả hai đều đạt >83% cận dương tại bán kính 10^-6." },
            { id: 9, title: "Slide 09: Căn Chỉnh Đặc Trưng H13: 3,866,112 Điểm Khớp Bitwise", tag: "Feature Alignment", desc: "Chứng minh thực nghiệm H13: 5,034 cặp cửa sổ x 12 vị trí x 64 channels qua 3 khối Conv đạt sai số tối đa bằng 0.000000 bitwise, xác nhận tính bất biến cục bộ của phép tích chập 1D." },
            { id: 10, title: "Slide 10: Rào Cản Số Học: Vì Sao Proof Số Thực Chưa Đủ Cho Float32 (H22)", tag: "Numerical Soundness", desc: "H22 bị bác bỏ: Chứng minh trên tập số thực R không bảo đảm tính đúng đắn trên phần cứng dấu chấm động float32 do lỗi làm tròn IEEE-754. Hệ thống áp dụng Fail-Closed nghiêm ngặt." },
            { id: 11, title: "Slide 11: Kiến Trúc Verifier trên Đồ Thị Thật (ecdr/week3_verifier.py)", tag: "Verifier Architecture", desc: "Xây dựng bộ kiểm chứng IBP trực tiếp trên computation graph của SmallCNN1D (Conv1D, BatchNorm, MaxPool1D, Flatten, Linear), không sao chép công thức mô hình Conv-GAP." },
            { id: 12, title: "Slide 12: Vòng Đời Chứng Chỉ & Thực Thi Fail-Closed (7 Bước)", tag: "Certificate Lifecycle", desc: "Giao thức 7 bước kiểm tra trước khi quyết định tái sử dụng. Bất kỳ bước nào không thỏa mãn (hết hạn, sai hash, ngoài miền S) đều kích hoạt Fallback chạy CNN đầy đủ." },
            { id: 13, title: "Slide 13: Khảo Sát auto-LiRPA / CROWN: Lỗi MaxPool1D & Giới Hạn", tag: "Tooling Limits", desc: "Khảo sát thư viện auto-LiRPA: Phát hiện xung đột phiên bản với PyTorch 2.14 và không hỗ trợ trực tiếp toán tử MaxPool1D thời gian, khẳng định sự đúng đắn của custom verifier." },
            { id: 14, title: "Slide 14: Giao Thức Thẩm Định 64 Anchors & Đóng Băng Bán Kính", tag: "Validation Protocol", desc: "Giao thức khoa học không rò rỉ: Thẩm định trên 64 mỏ neo tập Val, đóng băng bán kính rho = 10^-6 trước khi chạy test trên toàn bộ 5,053 cửa sổ tập kiểm thử." },
            { id: 15, title: "Slide 15: Hình Học Khám Phá: 9,944 Deltas, PCA 21.5%, Cosine 0.051", tag: "Empirical Geometry", desc: "9,944 vector dịch chuyển thời gian Delta: Top 3 PC chỉ chiếm 21.48% phương sai. Cosine similarity với gradient biên quyết định chỉ đạt 0.051 (trực giao 87 độ)." },
            { id: 16, title: "Slide 16: Nghịch Lý Bán Kính: 5,034 Builds Dương Nhưng 0 Next-Window Members", tag: "Radius Dilemma", desc: "Blocker A cốt lõi: 99.6% mỏ neo dựng được cận dương ở bán kính 10^-6, nhưng độ dịch chuyển tự nhiên giữa 2 cửa sổ liên tiếp là 0.1 - 1.0 (lệch 100,000 lần)! 0 cửa sổ kế tiếp thuộc miền S!" },
            { id: 17, title: "Slide 17: Replay 4 Luồng (20,212 Queries): 100% Fallback, 0 Sai Lệch", tag: "Stream Replay", desc: "Chạy stream replay trên 4 chuỗi dữ liệu: 100% queries chuyển sang Fallback. Tính bảo toàn quyết định đạt 100% (0 disagreements), nhưng tỷ lệ reuse đạt đúng 0.0%." },
            { id: 18, title: "Slide 18: Đo Đạc Chi Phí: 3.15 ms vs 1.63 ms (0.52x Speedup, Savings Âm)", tag: "Latency Deficit", desc: "Blocker B cốt lõi: Do verifier tốn 1.48 ms kiểm tra và fallback tốn 1.67 ms forward, tổng thời gian ECDR là 3.15 ms, chậm gấp 2 lần so với chạy CNN gốc (1.63 ms)!" },
            { id: 19, title: "Slide 19: Phân Rã Bộ Nhớ: Model 1.14 MB, Verifier 2.27 MB, Cert 54 KB", tag: "Memory Profile", desc: "Bộ nhớ RAM: CNN float32 chiếm 1.14 MB, Verifier float64 chiếm 2.27 MB, mỗi chứng chỉ chiếm 54 KB. Hoàn toàn phù hợp với cấu hình bộ nhớ của smartwatch." },
            { id: 20, title: "Slide 20: Phát Hiện Khoa Học: Chuỗi Nguyên Nhân Gốc (Blockers A & B)", tag: "Root Cause Chain", desc: "Tổng kết chuỗi nguyên nhân: IBP looseness -> bán kính rho quá hẹp (Blocker A); CNN quá nhẹ nên verifier overhead triệt tiêu toàn bộ lợi ích (Blocker B)." },
            { id: 21, title: "Slide 21: Kế Hoạch Chuyển Giao Tuần 4 Phân Cấp Ưu Tiên (P0 & P1)", tag: "Week 4 Roadmap", desc: "Lộ trình thực chất Tuần 4: [P0] Adaptive Dynamic Bounds bám theo gradient; [P0] Early Event Trigger Filter O(1); [P1] Incremental Feature Reuse giảm 50% Conv FLOPs." }
        ];

        let currentSlideW3 = 1;
        function renderSlideW3(n) {
            currentSlideW3 = n;
            document.getElementById('slide-num-w3').innerText = `${n} / ${week3SlidesData.length}`;
            const s = week3SlidesData[n - 1];
            const viewport = document.getElementById('w3-slide-viewport');
            viewport.innerHTML = `
                <div class="space-y-4">
                    <div class="flex items-center justify-between border-b border-black pb-2">
                        <span class="acad-badge acad-badge-black font-mono">${s.tag}</span>
                        <span class="font-mono text-xs text-zinc-500 font-bold">SLIDE ${s.id < 10 ? '0' + s.id : s.id} OF 21</span>
                    </div>
                    <h3 class="text-xl font-serif font-bold text-black">${s.title}</h3>
                    <p class="text-sm font-serif text-zinc-800 leading-relaxed">${s.desc}</p>
                </div>
                <div class="pt-4 border-t border-zinc-200 flex justify-between items-center text-xs font-mono text-zinc-600">
                    <span>Receipts Ledger: <code>output/week3_certification_20261103/</code></span>
                    <span>Test Suite: 93/93 PASS</span>
                </div>
            `;
            document.querySelectorAll('#w3-slide-pills button').forEach((btn, idx) => {
                btn.className = (idx + 1 === n) 
                    ? "px-2 py-0.5 text-[11px] font-mono font-bold border border-black bg-black text-white"
                    : "px-2 py-0.5 text-[11px] font-mono font-medium border border-black bg-white text-zinc-600 hover:bg-zinc-100";
            });
        }
        function nextSlideW3() { renderSlideW3(currentSlideW3 >= week3SlidesData.length ? 1 : currentSlideW3 + 1); }
        function prevSlideW3() { renderSlideW3(currentSlideW3 <= 1 ? week3SlidesData.length : currentSlideW3 - 1); }

        // Keyboard arrow navigation
        document.addEventListener('keydown', (e) => {
            const w1Active = !document.getElementById('content-week-1').classList.contains('hidden');
            const w2Active = !document.getElementById('content-week-2').classList.contains('hidden');
            const w3Active = !document.getElementById('content-week-3').classList.contains('hidden');
            if (e.key === 'ArrowRight') {
                if (w1Active) nextSlide();
                else if (w2Active) nextSlideW2();
                else if (w3Active) nextSlideW3();
            } else if (e.key === 'ArrowLeft') {
                if (w1Active) prevSlide();
                else if (w2Active) prevSlideW2();
                else if (w3Active) prevSlideW3();
            }
        });

        // 5. Week 3 Hypothesis Table Filter
        function filterHypotheses(status) {
            const rows = document.querySelectorAll('#hyp-tbody tr');
            const btns = {
                'all': document.getElementById('btn-hyp-all'),
                'DERIVED': document.getElementById('btn-hyp-der'),
                'CONDITIONAL': document.getElementById('btn-hyp-cnd'),
                'FALSIFIED': document.getElementById('btn-hyp-fal'),
                'NOT_ESTAB': document.getElementById('btn-hyp-not')
            };

            for (const k in btns) {
                if (btns[k]) {
                    btns[k].className = (k === status)
                        ? "px-3 py-1 border border-black bg-black text-white font-mono text-xs font-bold"
                        : "px-3 py-1 border border-black bg-white text-zinc-700 hover:bg-zinc-100 font-mono text-xs";
                }
            }

            rows.forEach(r => {
                const s = r.getAttribute('data-status');
                if (status === 'all') {
                    r.style.display = '';
                } else if (status === 'NOT_ESTAB') {
                    r.style.display = (s === 'NOT_ESTAB' || s === 'DESCRIPTIVE') ? '' : 'none';
                } else {
                    r.style.display = (s === status) ? '' : 'none';
                }
            });
        }

        // 6. Code Tab Switchers for Week 2 and Week 3
        function switchCodeTabW2(tabNum) {
            document.querySelectorAll('[id^="w2-code-pane-"]').forEach(el => el.classList.add('hidden'));
            const p = document.getElementById(`w2-code-pane-${tabNum}`);
            if (p) p.classList.remove('hidden');

            for (let i = 1; i <= 3; i++) {
                const b = document.getElementById(`btn-w2-c${i}`);
                if (b) {
                    b.className = (i === tabNum)
                        ? "px-3 py-1 border border-black bg-black text-white font-mono text-xs font-bold"
                        : "px-3 py-1 border border-black bg-white text-zinc-700 hover:bg-zinc-100 font-mono text-xs";
                }
            }
        }
        function copyCodeW2() {
            const p = document.querySelector('[id^="w2-code-pane-"]:not(.hidden) code');
            if (p) {
                navigator.clipboard.writeText(p.innerText).then(() => alert('Đã sao chép mã nguồn Python Tuần 2 vào clipboard!'));
            }
        }

        function switchCodeTabW3(tabNum) {
            document.querySelectorAll('[id^="w3-code-pane-"]').forEach(el => el.classList.add('hidden'));
            const p = document.getElementById(`w3-code-pane-${tabNum}`);
            if (p) p.classList.remove('hidden');

            for (let i = 1; i <= 3; i++) {
                const b = document.getElementById(`btn-w3-c${i}`);
                if (b) {
                    b.className = (i === tabNum)
                        ? "px-3 py-1 border border-black bg-black text-white font-mono text-xs font-bold"
                        : "px-3 py-1 border border-black bg-white text-zinc-700 hover:bg-zinc-100 font-mono text-xs";
                }
            }
        }
        function copyCodeW3() {
            const p = document.querySelector('[id^="w3-code-pane-"]:not(.hidden) code');
            if (p) {
                navigator.clipboard.writeText(p.innerText).then(() => alert('Đã sao chép mã nguồn Python Tuần 3 vào clipboard!'));
            }
        }

        // 7. Initialize Pills and Viewports on DOMContentLoaded
        document.addEventListener('DOMContentLoaded', () => {
            const w2PillsBox = document.getElementById('w2-slide-pills');
            if (w2PillsBox) {
                w2PillsBox.innerHTML = week2SlidesData.map((s, idx) => `
                    <button onclick="renderSlideW2(${idx + 1})" class="px-2.5 py-1 text-xs font-mono font-medium border border-black bg-white text-zinc-600 hover:bg-zinc-100">
                        ${idx + 1}
                    </button>
                `).join('');
                renderSlideW2(1);
            }

            const w3PillsBox = document.getElementById('w3-slide-pills');
            if (w3PillsBox) {
                w3PillsBox.innerHTML = week3SlidesData.map((s, idx) => `
                    <button onclick="renderSlideW3(${idx + 1})" class="px-2 py-0.5 text-[11px] font-mono font-medium border border-black bg-white text-zinc-600 hover:bg-zinc-100">
                        ${idx + 1}
                    </button>
                `).join('');
                renderSlideW3(1);
            }

            const inspector = document.getElementById('cm-inspector');
            const cells = document.querySelectorAll('.cm-cell');
            cells.forEach(cell => {
                cell.addEventListener('mouseenter', () => {
                    const act = cell.getAttribute('data-actual');
                    const pred = cell.getAttribute('data-pred');
                    const cnt = cell.getAttribute('data-count');
                    const tot = cell.getAttribute('data-total');
                    const pct = cell.getAttribute('data-pct');
                    inspector.innerHTML = `<span class="text-zinc-500">Thực tế:</span> <strong class="text-black">${act}</strong> &rarr; <span class="text-zinc-500">Dự đoán:</span> <strong class="text-black">${pred}</strong> | <span class="text-zinc-500">Mẫu:</span> <strong class="text-black underline">${cnt}/${tot}</strong> (${pct})`;
                });
            });
        });

        // 8. Per-Class Table Filter (Week 1)
        function filterClasses(type) {
            const rows = document.querySelectorAll('#per-class-tbody tr');
            const btnAll = document.getElementById('btn-filter-all');
            const btnBasic = document.getElementById('btn-filter-basic');
            const btnTrans = document.getElementById('btn-filter-trans');

            btnAll.className = "px-2.5 py-1 border border-black " + (type === 'all' ? "bg-black text-white font-bold" : "bg-white text-zinc-700 hover:bg-zinc-100");
            btnBasic.className = "px-2.5 py-1 border border-black " + (type === 'basic' ? "bg-black text-white font-bold" : "bg-white text-zinc-700 hover:bg-zinc-100");
            btnTrans.className = "px-2.5 py-1 border border-black " + (type === 'trans' ? "bg-black text-white font-bold" : "bg-white text-zinc-700 hover:bg-zinc-100");

            rows.forEach(r => {
                if (type === 'all') {
                    r.style.display = '';
                } else if (type === 'basic') {
                    r.style.display = r.classList.contains('cat-basic') ? '' : 'none';
                } else if (type === 'trans') {
                    r.style.display = r.classList.contains('cat-trans') ? '' : 'none';
                }
            });
        }

        // 9. Python Code Inspector Tabs (Week 1)
        function switchCodeTab(tabNum) {
            document.querySelectorAll('.code-pane').forEach(el => el.classList.add('hidden'));
            const activePane = document.getElementById(`code-pane-${tabNum}`);
            if (activePane) activePane.classList.remove('hidden');

            document.querySelectorAll('.code-tab-btn').forEach(btn => {
                const t = parseInt(btn.getAttribute('data-code'));
                btn.className = (t === tabNum) 
                    ? "code-tab-btn px-3 py-1 border border-black bg-black text-white font-bold"
                    : "code-tab-btn px-3 py-1 border border-black bg-white text-zinc-700 hover:bg-zinc-100";
            });
        }

        function copyCurrentCode() {
            const activePane = document.querySelector('.code-pane:not(.hidden) code');
            if (activePane) {
                navigator.clipboard.writeText(activePane.innerText).then(() => {
                    alert("Đã sao chép mã nguồn Python vào clipboard!");
                });
            }
        }
    </script>
</body>
</html>
