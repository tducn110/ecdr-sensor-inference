                        <div class="flex space-x-2">
                            <button onclick="switchCodeTabW2(1)" id="btn-w2-c1" class="px-3 py-1 border border-black bg-black text-white font-mono text-xs font-bold">1. Window Extractor</button>
                            <button onclick="switchCodeTabW2(2)" id="btn-w2-c2" class="px-3 py-1 border border-black bg-white text-zinc-700 hover:bg-zinc-100 font-mono text-xs">2. Train-Only Z-Score</button>
                            <button onclick="switchCodeTabW2(3)" id="btn-w2-c3" class="px-3 py-1 border border-black bg-white text-zinc-700 hover:bg-zinc-100 font-mono text-xs">3. Majority Voting Policy</button>
                        </div>
                        <button onclick="copyCodeW2()" class="px-3 py-1 border border-black bg-white hover:bg-zinc-100 font-mono text-xs text-black font-bold">Sao Chép Mã</button>
                    </div>

                    <!-- Pane 1: Window Extractor -->
                    <div id="w2-code-pane-1" class="p-4 bg-zinc-900 text-zinc-100 font-mono text-xs overflow-x-auto">
                        <pre><code># scripts/03_build_windows.py — Trích xuất cửa sổ trượt [6 x 128] từ tín hiệu thô
import numpy as np

WINDOW_SIZE = 128  # 2.56 seconds at 50 Hz
STRIDE = 64        # 1.28 seconds (50% temporal overlap)
CHANNELS = 6       # 3 Accel (X,Y,Z) + 3 Gyro (X,Y,Z)

def extract_sliding_windows(raw_signal, recording_id):
    \"\"\"
    raw_signal: np.ndarray shape (T, 6)
    Chỉ trượt cửa sổ trong phạm vi cùng một recording_id để tránh rách ranh giới.
    \"\"\"
    T, C = raw_signal.shape
    assert C == CHANNELS, f"Expected 6 channels, got {C}"
    
    windows = []
    num_windows = (T - WINDOW_SIZE) // STRIDE + 1
    for i in range(num_windows):
        start = i * STRIDE
        end = start + WINDOW_SIZE
        window = raw_signal[start:end, :]  # Shape (128, 6)
        windows.append(window.T)           # Transpose to (6, 128)
        
    return np.array(windows, dtype=np.float32)  # Shape (N, 6, 128)</code></pre>
                    </div>

                    <!-- Pane 2: Train-Only Z-Score -->
                    <div id="w2-code-pane-2" class="p-4 bg-zinc-900 text-zinc-100 font-mono text-xs overflow-x-auto hidden">
                        <pre><code># ecdr/preprocessing.py — Train-Only Z-score Normalization (Zero Data Leakage)
import torch

class TrainOnlyStandardizer:
    \"\"\"
    Mean và Std CHỈ ĐƯỢC PHÉP tính toán trên 17 người dùng thuộc tập Train.
    Val và Test áp dụng cố định các tham số này mà không cập nhật.
    \"\"\"
    def __init__(self, mean_vector, std_vector):
        # mean_vector, std_vector có shape (6, 1)
        self.mean = torch.tensor(mean_vector, dtype=torch.float32)
        self.std = torch.tensor(std_vector, dtype=torch.float32)
        # Ngăn chia cho 0
        self.std = torch.clamp(self.std, min=1e-7)

    def normalize(self, tensor_x):
        \"\"\"
        tensor_x: shape (B, 6, 128)
        output: normalized (B, 6, 128)
        \"\"\"
        return (tensor_x - self.mean) / self.std</code></pre>
                    </div>

                    <!-- Pane 3: Majority Voting Policy -->
                    <div id="w2-code-pane-3" class="p-4 bg-zinc-900 text-zinc-100 font-mono text-xs overflow-x-auto hidden">
                        <pre><code># scripts/03_build_windows.py — Chính sách gán nhãn đa số >= 60%
from collections import Counter

def assign_window_label(sample_labels, threshold=0.60):
    \"\"\"
    sample_labels: mảng 128 nhãn tương ứng với từng sample trong cửa sổ.
    Trả về: label_id nếu nhãn chiếm >= 60%, ngược lại trả về None (Ambiguous).
    \"\"\"
    counts = Counter(sample_labels)
    # Loại bỏ nhãn 0 (unlabeled / pause)
    counts.pop(0, None)
    if not counts:
        return None  # Toàn bộ cửa sổ là unlabeled
        
    most_common_label, count = counts.most_common(1)[0]
    fraction = count / len(sample_labels)
    
    if fraction >= threshold:
        return most_common_label
    return None  # Cửa sổ mơ hồ, bị loại khỏi tập supervised</code></pre>
                    </div>
                </div>
            </section>

            <!-- SECTION W2-7: TỔNG HỢP & KẾ HOẠCH TUẦN 3 -->
            <section id="w2-synthesis" class="space-y-6 max-w-4xl mx-auto">
                <div class="flex items-center justify-between border-b border-black pb-4">
                    <div class="flex items-center space-x-3">
                        <span class="w-8 h-8 border border-black bg-black text-white font-mono font-bold flex items-center justify-center text-xs">7</span>
                        <h2 class="text-2xl font-serif font-bold text-black">Tổng Hợp Tuần 2 &amp; Điểm Tựa Kỹ Thuật Cho Tuần 3</h2>
                    </div>
                    <span class="acad-badge acad-badge-gray">Synthesis &amp; Handover</span>
                </div>

                <div class="p-6 border border-black bg-zinc-50 space-y-4 text-xs font-serif leading-relaxed text-zinc-800">
                    <p>
                        <strong>Kết luận cốt lõi Tuần 2:</strong> Toàn bộ dữ liệu cảm biến HAPT đã được chuẩn hóa và khóa chặt theo đúng các tiêu chuẩn khoa học cao nhất. Việc xác lập tính chất <strong>50% Overlap trùng khớp tuyệt đối (MAE = 0.00000)</strong> giữa 17,392 cặp cửa sổ kế tiếp là phát hiện nền tảng mang tính quyết định: nó chứng minh rằng việc tính toán lại toàn bộ mạng nơ-ron từ đầu trên mọi cửa sổ là một sự lãng phí tài nguyên to lớn, tạo tiền đề trực tiếp cho bài toán Certified Decision Reuse.
                    </p>
                    <p>
