                        <pre id="code-pane-1" class="code-pane"><code># scripts/backbone.py - Kiến Trúc SmallCNN1D (K=12) với 283,692 tham số
import torch
import torch.nn as nn

class SmallCNN1D(nn.Module):
    """Input (B, 6, 128) -> Output (B, 12). Conv x3, MaxPool x2, Heavy Flatten-MLP."""
    def __init__(self, num_classes: int = 12):
        super().__init__()
        act = nn.ReLU
        self.conv = nn.Sequential(
            nn.Conv1d(6, 32, kernel_size=5, padding=2), nn.BatchNorm1d(32), act(),
            nn.MaxPool1d(2),
            nn.Conv1d(32, 64, kernel_size=3, padding=1), nn.BatchNorm1d(64), act(),
            nn.MaxPool1d(2),
            nn.Conv1d(64, 64, kernel_size=3, padding=1), nn.BatchNorm1d(64), act(),
        )
        self.head = nn.Sequential(
            nn.Flatten(),
            nn.Linear(64 * 32, 128),  # 262,272 params = 92.45% TỔNG THAM SỐ
            act(),
            nn.Linear(128, num_classes) # 1,548 params -> 12 logits
        )

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        return self.head(self.conv(x))</code></pre>

                        <pre id="code-pane-2" class="code-pane hidden"><code># scripts/week1_reference_pipeline.py - Chuẩn Hóa Z-Score & Mã Băm Định Danh
import numpy as np
import hashlib

def apply_norm(x: np.ndarray, mean: np.ndarray, std: np.ndarray) -> np.ndarray:
    \"\"\"Chuẩn hóa per-channel: chỉ fit trên tập Train (17 subjects), axes=(0, 2).\"\"\"
    return ((x - mean[None, :, None]) / std[None, :, None]).astype(np.float32)

def compute_preprocessing_id(mean: np.ndarray, std: np.ndarray) -> str:
    h = hashlib.sha256()
    h.update(b"norm:train_only:per_channel:axes_0_2:clip_1e-6:float32:")
    h.update(mean.tobytes())
    h.update(std.tobytes())
    return h.hexdigest()

# KHÓA BẤT BIẾN: aa8e1cc20829307187e0a78200f9957f7dd068b1dc26063c2720ad832bb2fd6e</code></pre>

                        <pre id="code-pane-3" class="code-pane hidden"><code># ecdr/margin_verifier.py - Điều Kiện Bảo Toàn Quyết Định Trên Toàn Bộ 11 Biên
import numpy as np

def verify_11_competing_margins(anchor_class: int, logits_lower_bounds: np.ndarray) -> bool:
    \"\"\"
    Điều kiện toán học ECDR: Quyết định c được bảo toàn trên miền S nếu:
    inf_{X in S} (F_c(X) - F_j(X)) > 0 đối với MỌI j != c (11 competing classes).
    \"\"\"
    c = anchor_class
    c_lower = logits_lower_bounds[c]
    for j in range(12):
        if j == c:
            continue
        # Bắt buộc cận dưới của lớp c phải nghiêm ngặt lớn hơn cận trên của lớp j
        if c_lower - logits_upper_bounds[j] <= 0:
            return False # Không đủ chứng nhận -> Fallback CNN
    return True # Hợp lệ -> Reuse nhãn c</code></pre>

                        <pre id="code-pane-4" class="code-pane hidden"><code># scripts/benchmark_cpu.py - Giao Thức Đo Độ Trễ Chuẩn
import time
import torch

# Đo kiểm CPU Intel Xeon W-11855M @ 3.20GHz, 1 thread, FP32
model.eval()
warmup_runs = 100
timed_runs = 1000

with torch.no_grad():
    for _ in range(warmup_runs):
        _ = model(dummy_input)
    
    times_ms = []
    for _ in range(timed_runs):
        t0 = time.perf_counter_ns()
        _ = model(sample_input)
        t1 = time.perf_counter_ns()
        times_ms.append((t1 - t0) / 1e6)

# Kết quả: Mean = 0.1734 ms, p50 = 0.1650 ms, p95 = 0.2153 ms</code></pre>
