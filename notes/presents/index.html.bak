            <!-- SECTION W3-2: HAI RÀO CẢN ĐỘC LẬP (BLOCKER A & B) -->
            <section id="w3-blockers" class="space-y-6 max-w-4xl mx-auto">
                <div class="flex items-center justify-between border-b border-black pb-4">
